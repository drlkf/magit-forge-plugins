;;; forge-plugins-prefetch-batch-test.el --- Tests for batched plugin dispatch  -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'forge)
(require 'forge-pullreq)
(require 'forge-plugins-github-actions)
(require 'forge-plugins-github-reviews)
(require 'forge-plugins-pullreq-approvals)

(defun forge-plugins-batch-test--run (prefix name)
  "Queue 3 topics for plugin PREFIX/NAME, hit on T1/T2 and miss on T3.
Return (BATCH-CALLS FETCHED PENDING INFLIGHT-AFTER-DISPATCH INFLIGHT-END)."
  (let* ((sym (lambda (s) (intern (format "%s--%s" prefix s))))
         (repo (forge-github-repository :id "r"))
         (topics (mapcar (lambda (id) (forge-pullreq :id id :head-rev "abc"))
                         '("T1" "T2" "T3")))
         (cache (make-hash-table :test 'equal))
         calls fetched pending callback after)
    (cl-progv (list (funcall sym "cache") (funcall sym "queue")
                    (funcall sym "queue-tail") (funcall sym "inflight"))
        (list cache nil nil 0)
      (dolist (topic topics)
        (puthash (oref topic id) (list :head-rev "abc" :fetching t) cache)
        (funcall (funcall sym "enqueue") topic))
      (cancel-timer (symbol-value (funcall sym "dispatch-timer")))
      (set (funcall sym "dispatch-timer") nil)
      (cl-letf (((symbol-function 'forge-get-repository) (lambda (_) repo))
                ((symbol-function 'forge-plugins-prefetch-batch)
                 (lambda (n ts cb)
                   (push (cons n ts) calls)
                   (setq callback cb)
                   (dolist (hit (seq-take ts 2))
                     (puthash (oref hit id) (list :head-rev "abc" :fetching nil)
                              cache))))
                ((symbol-function (funcall sym "fetch"))
                 (lambda (topic) (push (oref topic id) fetched)))
                ((symbol-function (funcall sym "note-pending"))
                 (lambda (topic) (push (oref topic id) pending))))
        (funcall (funcall sym "dispatch"))
        (setq after (symbol-value (funcall sym "inflight")))
        (funcall callback (cdar calls))
        (should (eq (caar calls) name)))
      (list (length calls) fetched pending after
            (symbol-value (funcall sym "inflight"))))))

(ert-deftest forge-plugins-batch-test-actions ()
  (pcase-let ((`(,calls ,fetched ,pending ,after ,end)
               (forge-plugins-batch-test--run
                "forge-plugins-github-actions" 'github-actions)))
    (should (= calls 1))
    (should (equal fetched '("T3")))
    (should (equal (sort pending #'string<) '("T1" "T2")))
    (should (= after 1))
    (should (= end 1))))

(ert-deftest forge-plugins-batch-test-reviews ()
  (pcase-let ((`(,calls ,fetched ,pending ,after ,end)
               (forge-plugins-batch-test--run
                "forge-plugins-github-reviews" 'github-reviews)))
    (should (= calls 1))
    (should (equal fetched '("T3")))
    (should (equal (sort pending #'string<) '("T1" "T2")))
    (should (= after 1))
    (should (= end 1))))

(ert-deftest forge-plugins-batch-test-approvals ()
  "Every topic still runs `--fetch' after the batch, balanced inflight."
  (let* ((repo (forge-github-repository :id "r"))
         (topics (mapcar (lambda (id) (forge-pullreq :id id :head-rev "abc"))
                         '("T1" "T2" "T3")))
         (forge-plugins-pullreq-approvals--queue nil)
         (forge-plugins-pullreq-approvals--queue-tail nil)
         (forge-plugins-pullreq-approvals--inflight 0)
         (forge-plugins-pullreq-approvals--dispatch-timer nil)
         calls fetched callback)
    (dolist (topic topics)
      (forge-plugins-pullreq-approvals--enqueue topic))
    (cancel-timer forge-plugins-pullreq-approvals--dispatch-timer)
    (setq forge-plugins-pullreq-approvals--dispatch-timer nil)
    (cl-letf (((symbol-function 'forge-get-repository) (lambda (_) repo))
              ((symbol-function 'forge-plugins-prefetch-batch)
               (lambda (n ts cb) (push (cons n ts) calls) (setq callback cb)))
              ((symbol-function 'forge-plugins-pullreq-approvals--fetch)
               (lambda (topic)
                 (push (oref topic id) fetched)
                 (forge-plugins-pullreq-approvals--fetch-done))))
      (forge-plugins-pullreq-approvals--dispatch)
      (should (= forge-plugins-pullreq-approvals--inflight 1))
      (funcall callback (cdar calls)))
    (should (= (length calls) 1))
    (should (eq (caar calls) 'pullreq-approvals))
    (should (equal (sort fetched #'string<) '("T1" "T2" "T3")))
    (should (= forge-plugins-pullreq-approvals--inflight 0))))

;;; forge-plugins-prefetch-batch-test.el ends here
